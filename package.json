{
  "name": "codemini-cli",
  "version": "0.9.5",
  "description": "An extremely restrained coding + tasks CLI. Every platform. Every terminal. Minimal by design.",
  "keywords": [
    "cli",
    "ai",
    "coding-assistant",
    "developer-tools",
    "terminal",
    "windows",
    "powershell"
  ],
  "type": "module",
  "homepage": "https://github.com/havingautism/Codemini-CLI#readme",
  "bugs": {
    "url": "https://github.com/havingautism/Codemini-CLI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havingautism/Codemini-CLI.git"
  },
  "bin": {
    "codemini": "bin/coder.js",
    "coder": "bin/coder.js"
  },
  "scripts": {
    "start": "node bin/coder.js",
    "test": "node --test tests/*.test.js",
    "build:web": "npm install --prefix codemini-web && npm run build --prefix codemini-web",
    "check:encoding": "node scripts/check-text-encoding.js",
    "prepack": "npm run build:web && node scripts/check-pack-imports.mjs",
    "pack:offline": "npm pack",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version"
  },
  "files": [
    "bin",
    "src",
    "codemini-web/server.js",
    "codemini-web/lib",
    "codemini-web/shared",
    "codemini-web/client/src/lib/plan-ui-state.js",
    "codemini-web/client/src/lib/message-context-parsers.js",
    "codemini-web/dist",
    "codemini-web/codemini_logo.png",
    "souls",
    "templates",
    "README.md",
    "OPERATIONS.md",
    "deployment.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.75",
    "@ast-grep/napi": "^0.45.3",
    "@cursorless/tree-sitter-wasms": "^0.10.0",
    "@earendil-works/pi-tui": "^0.84.4",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/ripgrep": "^1.18.0",
    "cheerio": "^1.2.0",
    "cli-truncate": "^6.1.1",
    "eventsource-parser": "^4.1.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "hono": "^4.13.5",
    "ignore": "^7.0.8",
    "jsonrepair": "^3.15.0",
    "lru-cache": "^11.5.2",
    "mammoth": "^1.12.2",
    "microsandbox": "0.6.17",
    "node-addon-landlock-run": "^0.0.1",
    "node-pty": "^1.1.0",
    "p-limit": "^7.3.2",
    "pdf-parse": "2.4.5",
    "sharp": "^0.35.4",
    "shell-quote": "^1.10.0",
    "strip-ansi": "^7.2.0",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@ast-grep/lang-bash": "^0.0.8",
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-php": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7"
  }
}
