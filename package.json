{
  "name": "codemini-cli",
  "version": "0.10.4",
  "description": "An extremely restrained coding + tasks CLI. Every platform. Every terminal. Minimal by design.",
  "keywords": [
    "cli",
    "ai",
    "coding-assistant",
    "developer-tools",
    "terminal",
    "windows",
    "powershell"
  ],
  "type": "module",
  "main": "desktop/main.cjs",
  "homepage": "https://github.com/havingautism/Codemini-CLI#readme",
  "bugs": {
    "url": "https://github.com/havingautism/Codemini-CLI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havingautism/Codemini-CLI.git"
  },
  "bin": {
    "codemini": "bin/coder.js",
    "coder": "bin/coder.js"
  },
  "scripts": {
    "start": "node bin/coder.js",
    "test": "node scripts/run-tests.js",
    "bench:tools": "node scripts/bench-tools.mjs",
    "build:web": "npm install --prefix codemini-web && npm run build --prefix codemini-web",
    "check:encoding": "node scripts/check-text-encoding.js",
    "proto:goal": "node .scratch/goal-mode/prototypes/goal-command-prototype.js",
    "prepack": "npm run build:web && node scripts/check-pack-imports.mjs",
    "pack:offline": "npm pack",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "desktop:start": "electron .",
    "desktop:dir": "electron-builder --config desktop/electron-builder.config.cjs --dir",
    "desktop:dist:win": "electron-builder --config desktop/electron-builder.config.cjs --win nsis --x64 --publish never",
    "desktop:dist:win:arm64": "electron-builder --config desktop/electron-builder.config.cjs --win nsis --arm64 --publish never",
    "desktop:dist:mac": "electron-builder --config desktop/electron-builder.config.cjs --mac dmg --arm64 --publish never",
    "desktop:dist:mac:x64": "electron-builder --config desktop/electron-builder.config.cjs --mac dmg --x64 --publish never"
  },
  "files": [
    "bin",
    "src",
    "codemini-web/server.js",
    "codemini-web/lib",
    "codemini-web/shared",
    "codemini-web/client/src/lib/plan-ui-state.js",
    "codemini-web/client/src/lib/crew-ui-state.js",
    "codemini-web/client/src/lib/message-context-parsers.js",
    "codemini-web/dist",
    "codemini-web/codemini_logo.png",
    "souls",
    "templates",
    "README.md",
    "OPERATIONS.md",
    "deployment.md",
    "DESKTOP.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.83",
    "@ast-grep/napi": "^0.51.3",
    "@cursorless/tree-sitter-wasms": "^0.14.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@firecrawl/anydoc": "0.2.5",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/ripgrep": "^1.18.0",
    "cheerio": "^1.2.0",
    "cli-truncate": "^6.2.0",
    "eventsource-parser": "^4.1.3",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "hono": "^4.13.21",
    "ignore": "^7.0.16",
    "jsonrepair": "^3.15.0",
    "lru-cache": "^11.5.3",
    "microsandbox": "0.8.1",
    "node-addon-landlock-run": "^0.0.1",
    "node-pty": "^1.1.0",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0",
    "strip-ansi": "^7.2.0",
    "undici": "^8.13.1",
    "web-tree-sitter": "^0.27.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "optionalDependencies": {
    "@ast-grep/lang-bash": "^0.0.8",
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-php": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@superradcompany/microsandbox-darwin-arm64": "0.8.1",
    "@superradcompany/microsandbox-linux-arm64-gnu": "0.8.1",
    "@superradcompany/microsandbox-linux-x64-gnu": "0.8.1",
    "@superradcompany/microsandbox-win32-arm64-msvc": "0.8.1",
    "@superradcompany/microsandbox-win32-x64-msvc": "0.8.1"
  }
}
