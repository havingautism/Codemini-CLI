{
  "name": "codemini-cli",
  "version": "0.3.9",
  "description": "Coding CLI optimized for small-model workflows and Windows PowerShell",
  "keywords": [
    "cli",
    "ai",
    "coding-assistant",
    "developer-tools",
    "terminal",
    "windows",
    "powershell"
  ],
  "type": "module",
  "homepage": "https://github.com/havingautism/Codemini-CLI#readme",
